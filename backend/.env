# Application environment: development | production
# Determines which env file is loaded (.env vs .env.production).
APP_ENV=development

# Application
APP_NAME=YoraPet API
APP_VERSION=0.1.0
DEBUG=true
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Database
MYSQL_HOST=saravanas-mac-mini.tailfef550.ts.net
MYSQL_PORT=3306
MYSQL_USER=sysadmin
MYSQL_PASSWORD=apple@1239
MYSQL_DATABASE=yorapet
MYSQL_DRIVER=asyncmy

# Connection pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=console

# Authentication
JWT_SECRET_KEY=development-only-change-this-64-character-secret-before-deploying
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_COOKIE_SECURE=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMeNow!2026
ADMIN_DISPLAY_NAME=Administrator
