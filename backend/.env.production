# Application environment: development | production
# Determines which env file is loaded (.env vs .env.production).
APP_ENV=production

# Application
APP_NAME=YoraPet API
APP_VERSION=0.1.0
DEBUG=false
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Database
MYSQL_HOST=saravanas-mac-mini.tailfef550.ts.net
MYSQL_PORT=3306
MYSQL_USER=sysadmin
MYSQL_PASSWORD=apple@1239
MYSQL_DATABASE=yorapet
MYSQL_DRIVER=asyncmy

# Connection pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false

# CORS (comma-separated origins)
CORS_ORIGINS=https://pet.yoratech.com,http://pet.yoratech.com
CORS_ALLOW_CREDENTIALS=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Authentication
JWT_SECRET_KEY=development-only-change-this-64-character-secret-before-deploying
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_COOKIE_SECURE=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMeNow!2026
ADMIN_DISPLAY_NAME=Administrator
