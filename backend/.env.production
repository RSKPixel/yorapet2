# Application environment: development | production
# Determines which env file is loaded (.env vs .env.production).
APP_ENV=production

# Application
APP_NAME=YoraPet API
APP_VERSION=0.1.0
DEBUG=false
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Database (placeholders — inject real credentials at deploy time)
MYSQL_HOST=sivendhi.com
MYSQL_PORT=3306
MYSQL_USER=sysadmin
MYSQL_PASSWORD=Apple@1239
MYSQL_DATABASE=yorapet
MYSQL_DRIVER=asyncmy

# Connection pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false

# CORS (comma-separated origins)
CORS_ORIGINS=https://app.example.com
CORS_ALLOW_CREDENTIALS=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Authentication (inject strong secrets and optional seed credentials at deploy time)
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-64-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_COOKIE_SECURE=true
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Administrator
