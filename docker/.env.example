APP_ENV=production
LOG_LEVEL=INFO
LOG_FORMAT=json
DEBUG=false

# Browser origins that will hit this stack (include LAN IP if used)
CORS_ORIGINS=http://localhost:8002,http://127.0.0.1:8002,http://pet.yoratech.com,https://pet.yoratech.com
CORS_ALLOW_CREDENTIALS=true

# External MySQL (not managed by this compose file)
# Use a hostname/IP reachable FROM INSIDE the backend container.
# - MySQL on same Docker host: host.docker.internal
# - Remote / Tailscale MySQL: the real host (e.g. saravanas-mac-mini.tailfef550.ts.net)
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=sysadmin
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=yorapet
MYSQL_DRIVER=asyncmy

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false

JWT_SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_COOKIE_SECURE=true

ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMeNow!2026
ADMIN_DISPLAY_NAME=Administrator

# Host port published by frontend/nginx
YORAPET_PORT=8002
