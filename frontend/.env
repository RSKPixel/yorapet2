# Application
VITE_APP_NAME=YORA PET
VITE_APP_VERSION=0.1.0

# API — same-origin via Vite proxy so auth cookies stick across refresh.
# Do not point this at http://127.0.0.1 when the app is opened on localhost
# (or vice versa); that drops HttpOnly cookies as third-party.
VITE_API_BASE_URL=/api/v1

# Feature flags
VITE_ENABLE_API_HEALTH_CHECK=true
